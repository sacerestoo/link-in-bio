{
  "name": "@grabbin/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client.ts",
    "./schema/*": "./src/schema/*.ts",
    "./queries/*": "./src/queries/*.ts"
  },
  "scripts": {
    "db:generate": "bun --env-file=../../.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "bun --env-file=../../.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "lint": "vp lint",
    "test": "vp test run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
