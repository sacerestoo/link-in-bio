#!/bin/sh

set -e

if [ -n "$(git status --porcelain)" ]; then
  echo "Commit or stash local changes before pushing."
  exit 1
fi

(
  cd apps/scrapper
  uv run --extra lint ruff check .
  uv run --extra lint ruff format --check .
)

vp run -r --concurrency-limit 1 test
bun run check:fix

if [ -n "$(git status --porcelain)" ]; then
  echo "Quality fixes changed files. Commit them, then run push again."
  exit 1
fi

vp run -r build
