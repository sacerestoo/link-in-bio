# Cron Worker local settings. Production secrets are loaded by the Deploy job.
CLOUDFLARE_SAAS_ZONE_ID=fake-cloudflare-zone-id
CLOUDFLARE_SAAS_API_TOKEN=fake-cloudflare-api-token

CREEM_API_KEY=creem_test_fake_api_key
CREEM_TEST_MODE=true
CREEM_PRO_MONTHLY_PRODUCT_ID=prod_fake_monthly
CREEM_PRO_YEARLY_PRODUCT_ID=prod_fake_yearly

CUSTOM_DOMAIN_TARGET=custom.example.com
DOMAIN=example.com

CRON_DRY_RUN=false
