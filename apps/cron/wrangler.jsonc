{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "grabbin-cron",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "observability": { "enabled": true },
  // Daily at 06:00 UTC (15:00 Asia/Seoul).
  "triggers": { "crons": ["0 6 * * *"] },
  // Production uses the existing grabbin Hyperdrive; local dev connects to
  // the Supabase database running in Docker.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "dd7809a8db2a4b69aa50dcc5f0bfdb5f",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:54322/postgres",
    },
  ],
}
