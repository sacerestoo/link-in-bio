{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "grabbin",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "region": "aws:ap-southeast-1" },
  "main": "./worker.ts",
  "routes": [{ "pattern": "grabbin.me", "custom_domain": true }],
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "images": { "binding": "IMAGES" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "grabbin" }],
  "observability": { "enabled": true },
  // Production vars are supplied and checked by tooling/deploy-worker.ts.
  "services": [{ "binding": "SERVER", "service": "grabbin-server" }],
  "env": {
    "staging": {
      "name": "grabbin-staging",
      "workers_dev": true,
      "routes": [],
      "assets": {
        "not_found_handling": "none",
        "binding": "ASSETS",
      },
      "images": { "binding": "IMAGES" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "r2_buckets": [
        { "binding": "R2_BUCKET", "bucket_name": "grabbin-staging" },
      ],
      "services": [
        { "binding": "SERVER", "service": "grabbin-server-staging" },
      ],
      "observability": { "enabled": true },
    },
  },
  // Production secrets are loaded by the Deploy job; local secrets go in .env.local.
}
