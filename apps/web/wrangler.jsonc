{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "grabbin-web",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  "vars": {
    "BETTER_AUTH_URL": "https://grabbin.me",
    "CREEM_TEST_MODE": "true",
  },
  // Production uses the existing grabbin Hyperdrive; local dev connects to
  // the Supabase database running in Docker.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "dd7809a8db2a4b69aa50dcc5f0bfdb5f",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:54322/postgres",
    },
  ],
  // Secrets (set with `wrangler secret put`; locally in .env.local):
  // BETTER_AUTH_SECRET, CREEM_API_KEY, CREEM_WEBHOOK_SECRET
}
