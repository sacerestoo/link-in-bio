{
  "name": "grabbin",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run typegen && vp check && bun run check:architecture",
    "check:architecture": "bun run tooling/check-architecture.ts",
    "check:bundle": "wrangler deploy --dry-run --config apps/web/dist/server/wrangler.json && wrangler deploy --dry-run --config apps/cron/dist/grabbin_cron/wrangler.json",
    "check:env": "bun --conditions=react-server tooling/check-env.ts",
    "check:fix": "vp lint --fix && vp fmt .",
    "db:local": "docker compose --env-file .env.local -f compose.neon.yaml up -d",
    "db:local:stop": "docker compose --env-file .env.local -f compose.neon.yaml down",
    "dev": "vp -C apps/web dev",
    "dev:cron": "vp -C apps/cron dev",
    "lint": "vp lint",
    "prepare": "vp config --no-agent",
    "push:checked": "bun run tooling/push-checked.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typegen": "vp run --no-cache -r typegen",
    "verify": "bun run check && bun run check:env && vp run -r typecheck && vp run -r test && vp run -r build && bun run check:bundle"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.7.2",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "^7.0.2",
    "typescript-dependency-cruiser": "npm:typescript@6.0.3",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "better-auth": "^1.7.22",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "server-only": "0.0.1",
    "valibot": "^1.5.0",
    "vinext": "1.4.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0",
    "wrangler": "4.161.0"
  }
}
