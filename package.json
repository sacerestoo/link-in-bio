{
  "name": "grabbin",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run typegen && vp check && bun run check:architecture",
    "check:architecture": "bun run tooling/check-architecture.ts",
    "check:env": "bun --conditions=react-server tooling/check-env.ts",
    "check:fix": "vp fmt .",
    "dev": "vp -C apps/web dev",
    "dev:cron": "vp -C apps/cron dev",
    "lint": "vp lint tooling vite.config.ts .dependency-cruiser.ts",
    "prepare": "vp config --no-agent",
    "push:checked": "bun run tooling/push-checked.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typegen": "vp run --no-cache -r typegen",
    "verify": "bun run check && bun run check:env && vp run -r typecheck && vp run -r test && vp run -r build"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.7.2",
    "typescript": "^7.0.2",
    "typescript-dependency-cruiser": "npm:typescript@6.0.3",
    "valibot": "^1.5.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0",
    "wrangler": "4.161.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "wrangler": "4.161.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4"
}
