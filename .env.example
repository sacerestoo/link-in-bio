# Setting names for grabbin. Values here are fake placeholders, never real
# secrets. Local Worker settings go in apps/<app>/.dev.vars (gitignored);
# production secrets are set with `wrangler secret put <NAME>`.

# drizzle-kit (packages/db): local Postgres used for migrations.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/grabbin

# apps/web
BETTER_AUTH_URL=http://127.0.0.1:5173
BETTER_AUTH_SECRET=fake-better-auth-secret-at-least-32-chars
CREEM_API_KEY=creem_test_fake_api_key
CREEM_WEBHOOK_SECRET=whsec_fake_webhook_secret
CREEM_TEST_MODE=true

# apps/cron
CRON_DRY_RUN=false
