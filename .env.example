# Root tools only: Neon Local for Docker and Drizzle Kit.
# Never copy NEON_API_KEY into either app's .env.local.
# NEON_RUNTIME_ROLE_PASSWORD is for connecting as app_runtime.
NEON_API_KEY=fake-neon-api-key
NEON_PROJECT_ID=fake-project-id
NEON_DEV_BRANCH_ID=fake-dev-branch-id
NEON_RUNTIME_ROLE_PASSWORD=fake-runtime-role-password
DATABASE_URL=postgres://neon:npg@127.0.0.1:15433/neondb?sslmode=no-verify
